            { id:'testimonials', label:'10. Testimonial Alumni',  icon:'rate_review' },
            { id:'contact_form', label:'11. Form Kontak (Email)', icon:'email' },
            { id:'contact_info', label:'12. Peta & Lokasi Kampus', icon:'place' },
        ],
        hero: {
