            title: @json($secNews['title'] ?? ''),
            featured: @json($secNews['featured'] ?? []),
            smallArticles: @json($secNews['smallArticles'] ?? [])
        },
        partner: {
            label: @json($secPartner['label'] ?? ''),
            title: @json($secPartner['title'] ?? ''),
            desc: @json($secPartner['desc'] ?? '')
        },
        testimonials: {
            overline: @json($secTestimonialHeader['overline'] ?? ''),
            title: @json($secTestimonialHeader['title'] ?? ''),
            subtitle: @json($secTestimonialHeader['subtitle'] ?? '')
        },
        contactForm: {
            title: @json($secContactForm['title'] ?? ''),
            subtitle: @json($secContactForm['subtitle'] ?? ''),
