            formData.append('sections[campus][content][fotos]', JSON.stringify(this.campus.fotos));

            formData.append('sections[academy][content][label]', this.academy.label);
            formData.append('sections[academy][content][headline]', this.academy.headline);
            formData.append('sections[academy][content][cards]', JSON.stringify(this.academy.cards));

            formData.append('sections[facilities][content][title]', this.facilities.title);
            formData.append('sections[facilities][content][items]', JSON.stringify(this.facilities.items));

            formData.append('sections[director][content][label]', this.director.label);
            formData.append('sections[director][content][message]', this.director.message);
            formData.append('sections[director][content][name]', this.director.name);
            formData.append('sections[director][content][title]', this.director.title);

            formData.append('sections[news][content][label]', this.news.label);
            formData.append('sections[news][content][title]', this.news.title);
            formData.append('sections[news][content][featured]', JSON.stringify(this.news.featured));
            formData.append('sections[news][content][smallArticles]', JSON.stringify(this.news.smallArticles));

            formData.append('sections[partner][content][label]', this.partner.label);
            formData.append('sections[partner][content][title]', this.partner.title);
            formData.append('sections[partner][content][desc]', this.partner.desc);

            formData.append('sections[testimonial_header][content][overline]', this.testimonials.overline);
            formData.append('sections[testimonial_header][content][title]', this.testimonials.title);
            formData.append('sections[testimonial_header][content][subtitle]', this.testimonials.subtitle);

            formData.append('sections[contact_form][content][title]', this.contactForm.title);
            formData.append('sections[contact_form][content][subtitle]', this.contactForm.subtitle);
            formData.append('sections[contact_form][content][recipient_email]', this.contactForm.recipientEmail);
            formData.append('sections[contact_form][content][button_text]', this.contactForm.buttonText);

            formData.append('sections[contact][content][denpasar_address]', this.contact.denpasar.address);
            formData.append('sections[contact][content][denpasar_wa]', this.contact.denpasar.wa);
            formData.append('sections[contact][content][denpasar_email]', this.contact.denpasar.email);
            formData.append('sections[contact][content][klungkung_address]', this.contact.klungkung.address);
            formData.append('sections[contact][content][klungkung_phone]', this.contact.klungkung.phone);
            formData.append('sections[contact][content][klungkung_wa]', this.contact.klungkung.wa);

            fetch('/backoffice/beranda/update', { method: 'POST', body: formData })
                .then(r => {
                    if (r.ok) {
                        this.saved = true;
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                        setTimeout(() => this.saved = false, 4000);
                    } else {
                        alert('Gagal menyimpan konten beranda.');
                    }
                });
        }
    };
}
</script>
@endpush



