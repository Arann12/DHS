        saveAll() {
            const formData = new FormData();
            formData.append('_token', '{{ csrf_token() }}');
            formData.append('sections[hero][content][overline]', this.hero.overline);
            formData.append('sections[hero][content][headline]', this.hero.headline);
            formData.append('sections[hero][content][cta1_text]', this.hero.cta1Text);
            formData.append('sections[hero][content][cta1_link]', this.hero.cta1Link);
            formData.append('sections[hero][content][cta2_text]', this.hero.cta2Text);
            formData.append('sections[hero][content][cta2_link]', this.hero.cta2Link);
            formData.append('sections[hero][content][scroll_text]', this.hero.scrollText);
            formData.append('sections[hero][content][background_image]', this.hero.image);

            formData.append('sections[about][content][label]', this.about.label);
            formData.append('sections[about][content][headline]', this.about.headline);
            formData.append('sections[about][content][paragraph1]', this.about.p1);
            formData.append('sections[about][content][paragraph2]', this.about.p2);
            formData.append('sections[about][content][note]', this.about.note);
            formData.append('sections[about][content][image]', this.about.image);

            formData.append('sections[vision][content][sectionTitle]', this.vision.sectionTitle);
            formData.append('sections[vision][content][visiLabel]', this.vision.visiLabel);
            formData.append('sections[vision][content][vision_text]', this.vision.visiText);
            formData.append('sections[vision][content][misiLabel]', this.vision.misiLabel);
            formData.append('sections[vision][content][misiItems]', JSON.stringify(this.vision.misiItems));
