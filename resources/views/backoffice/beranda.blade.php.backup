<script>
// Alpine Store untuk Image Upload Modal
document.addEventListener('alpine:init', () => {
    Alpine.store('imageUpload', {
        isOpen: false,
        callback: null,
        open(callback) {
            this.isOpen = true;
            this.callback = callback;
        },
        close() {
            this.isOpen = false;
            this.callback = null;
        },
        apply(value) {
            if (this.callback) this.callback(value);
            this.close();
        }
    });
});

function imageUploadModal() {
    return {
        mode: 'url',
        tempUrl: '',
        preview: '',
        applyUrl() {
            if (this.tempUrl) {
                Alpine.store('imageUpload').apply(this.tempUrl);
            }
        },
        handleFileUpload(e) {
            const file = e.target.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = (ev) => {
                this.preview = ev.target.result;
                Alpine.store('imageUpload').apply(ev.target.result);
            };
            reader.readAsDataURL(file);
        }
    };
}

function berandaCompleteData() {
    return {
        saved: false,
        activeTab: 'hero',
        tabs: [
            { id:'hero',         label:'1. Hero Section',         icon:'wallpaper' },
            { id:'about',        label:'2. Sekilas DHS',          icon:'auto_stories' },
