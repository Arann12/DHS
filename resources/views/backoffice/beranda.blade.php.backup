            fotos: @json($secCampus['fotos'] ?? [])
        },
        academy: {
            label: @json($secAcademy['label'] ?? ''),
            headline: @json($secAcademy['headline'] ?? ''),
            cards: @json($secAcademy['cards'] ?? [])
        },
        facilities: {
            title: @json($secFacilities['title'] ?? ''),
            items: @json($secFacilities['items'] ?? [])
        },
        director: {
            label: @json($secDirector['label'] ?? ''),
            message: @json($secDirector['message'] ?? ''),
            name: @json($secDirector['name'] ?? ''),
            title: @json($secDirector['title'] ?? '')
        },
        news: {
